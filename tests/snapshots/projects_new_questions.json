{
  "version": 1,
  "command": "projects new --yes",
  "how_to_answer": {
    "text": "--flag VALUE",
    "select": "--flag CHOICE",
    "multiselect": "repeat --flag CHOICE; omitted means every choice",
    "confirm": "--flag or --no-flag",
    "int": "--flag NUMBER",
    "list": "repeat --flag VALUE",
    "pairs": "repeat --flag KEY=VALUE",
    "per_item": "repeat --flag ITEM=VALUE, one per item of items_from",
    "custom": "see the question's custom kind under custom_kinds"
  },
  "procedure": [
    "You are running this command for a user. Ask them the questions below, then run the command with their answers; do not answer for them.",
    "Go through the questions in order, a few at a time, grouped by section, using whatever way of asking the user you have.",
    "Skip a question whose when_all/when_any does not hold for the answers, options and facts so far.",
    "Offer a select or multiselect question's choices (choices, choices_now, with their labels) as options and a confirm question as yes/no. For a free-text question, offer its suggestions_now as options and accept any other value the user gives.",
    "Ask each applicable group once, as whether to keep its questions' defaults; ask the group's questions one by one only if the user wants a change. Do not bundle any other questions.",
    "A required question must be answered. Do not ask a prompted: false question unless the user brings it up.",
    "Before running, describe each consent that can apply and pass --yes only once the user has agreed to all of them. Consent does not carry over to another run.",
    "Run `command` with one flag per answer, as how_to_answer shows; leave out the flag of an answer that kept its default.",
    "If the run rejects a value, ask that question again with the error, then rerun."
  ],
  "rules": [
    "Passing a flag for a question that does not apply fails the run.",
    "Without its flag a question takes its default under --yes; a required question has no safe default.",
    "A default may reference earlier answers ({name}) and, for per_item, {item}.",
    "choices_from/items_from/suggestions_from name a dynamic source; choices_now, items_now and suggestions_now list its current values when it is local, otherwise the CLI checks the answer when it runs.",
    "prompted false: a setting the terminal interview never asks.",
    "consents: confirmations the run may need, given by --yes."
  ],
